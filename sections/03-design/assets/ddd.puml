@startuml domain-model
skinparam packageStyle cloud
skinparam shadowing false
skinparam rectangle {
  BackgroundColor #FFF3B0
  BorderColor black
}
skinparam package {
  BackgroundColor #BFD7F2
  BorderColor #3A6EA5
  FontStyle bold
}

package "Shared Kernel" {
  rectangle Office
}

package "Booking Context" {
  rectangle Appointment
  rectangle Shift
  rectangle Employee
  rectangle TimeSlot

  Shift ..> TimeSlot : expands into
  Appointment --> TimeSlot : occupies
  Appointment --> Employee : handled by
  Shift --> Employee : declared by
}

package "Support Context" {
  rectangle Faq
  rectangle Inquiry
  rectangle Match

  Match --> Faq
  Inquiry ..> Match : records
}

package "Identity Context" {
  rectangle User
  rectangle Role
  rectangle Credentials
  rectangle StudentProfile

  User --> Role
  User --> Credentials
  User --> StudentProfile
}

Appointment --> Office
Employee --> Office : works for
Faq --> Office : filed under
Inquiry --> Office : asked about
Appointment ..> Faq : suggested
Appointment ..> User : booked by
Employee ..> User : is
@enduml
