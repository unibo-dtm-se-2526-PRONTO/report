@startuml domain-model
title Pronto: Bounded Context Map (DDD)
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam nodesep 40
skinparam ranksep 50
skinparam rectangle {
  BackgroundColor #F2F2F2
  BorderColor #555555
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

package "Identity Context" as IC {
  rectangle "User\n«Aggregate Root»" as User
  rectangle "StudentProfile\n«Entity»" as StudentProfile
  rectangle "Role\n«Value Object»" as Role
  rectangle "Credentials\n«Value Object»" as Credentials
  User *-- StudentProfile
  User -- Role
  User -- Credentials
}

package "Booking Context" as BC {
  rectangle "BookingService\n«Domain Service»" as BookingService
  rectangle "Appointment\n«Aggregate Root»" as Appointment
  rectangle "EmployeeProfile\n«Aggregate Root»" as Employee
  rectangle "Shift\n«Entity»" as Shift
  rectangle "TimeSlot\n«Value Object»" as TimeSlot
  rectangle "Office\n«Aggregate Root, Shared Kernel»" as Office
  rectangle "AppointmentBooked\nAppointmentCancelled\n«Domain Event»" as BookingEvents
  rectangle "NotificationService\n«Domain Service»" as NotificationService

  BookingService --> Appointment : books, cancels,\ncompletes
  Appointment --> Employee : handled by
  Employee *-- Shift
  Appointment *-- TimeSlot
  Employee --> Office : works for
  BookingService ..> BookingEvents : raises
  BookingEvents ..> NotificationService : handled by
}

package "Support Context" as SC {
  rectangle "InquiryService\n«Application Service»" as InquiryService
  rectangle "FaqMatchingService\n«Domain Service»" as Matching
  rectangle "Inquiry\n«Aggregate Root»" as Inquiry
  rectangle "Match\n«Value Object»" as Match
  rectangle "Faq\n«Aggregate Root»" as Faq
  rectangle "FaqIndex\n«Repository (derived)»" as FaqIndex
  rectangle "FaqChanged\n«Domain Event»" as FaqChanged

  InquiryService -down-> Matching
  InquiryService -down-> Inquiry : records
  Matching -down-> Match : produces
  Match -right-> Faq
  Faq -down.> FaqChanged : raises
  FaqChanged -left.> FaqIndex : keeps in step
}

BC ..> IC : Conformist\n(appointments and employees\nrefer to Identity's User)
BC ..> SC : Customer/Supplier, one way\n(an appointment refers to the suggested FAQ)
SC .. Office : Shared Kernel\n(FAQs and inquiries filed under an office)
@enduml
