@startuml seq1
skinparam shadowing false
actor Student as student
participant "Routes" as routes
participant "InquiryService" as inq
participant "FaqMatchingService" as faqsvc
database "Database" as db
database "Vector store" as vs

student -> routes : POST /questions (question)
routes -> inq : ask(question, language)
inq -> faqsvc : findBestMatch(question, no office)

faqsvc -> db : full-text search over the\npublished FAQs of every office
db --> faqsvc : best FAQ with rank ≥ threshold, or none
opt no full-text match
  faqsvc -> faqsvc : embed question\n(local model)
  faqsvc -> vs : nearest FAQ question in the same\nlanguage, among the published FAQs
  vs --> faqsvc : FAQ and similarity
  note right of vs : store unreachable:\nerror logged,\nno semantic match
  faqsvc -> faqsvc : keep it if similarity ≥ threshold
end
faqsvc --> inq : Match(FAQ, score, method) or none

inq -> db : record inquiry\n(office of the FAQ, FAQ, score, method)
inq --> routes : inquiry
routes --> student : inquiry id, suggested answer,\noffice it belongs to

alt the answer is satisfactory
  student -> routes : POST /questions/{id}/resolve
  routes -> inq : resolve(inquiry)
  note right : flow ends, no appointment created
else not satisfactory, or no match at all
  student -> routes : GET /offices/{office}/availability?date
  note right : office of the answer,\nor one picked from the list
  routes --> student : free slots
  student -> routes : POST /appointments\n(office, slot, question, suggested FAQ)
  note right : see the concurrent booking diagram
end
@enduml
