@startuml seq1
actor Student as student
participant "Routes" as routes
participant "FaqMatchingService" as faqsvc
database "Database" as db

student -> routes : POST /questions (office, question)
routes -> faqsvc : match(office, question)
faqsvc -> db : search FAQs in office\n(full-text + vector similarity)
db --> faqsvc : best match (if any)

alt match found in office
  faqsvc --> routes : Match(answer, office, score)
else no match in office
  faqsvc -> db : search FAQs across all offices
  db --> faqsvc : best match elsewhere (if any)
  faqsvc --> routes : Match(answer, actualOffice, score) or none
end

routes --> student : suggested answer\n(+ correct office, if reassigned)

alt answer resolves the request
  student -> routes : mark as satisfactory
  note right : flow ends, no appointment created
else not satisfactory (or no match at all)
  student -> routes : book appointment\n(chosen or corrected office)
end
@enduml
