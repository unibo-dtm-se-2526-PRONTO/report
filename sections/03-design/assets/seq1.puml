@startuml seq1
actor Student as student
participant "Routes" as routes
participant "FaqMatchingService" as faqsvc
participant "FaqRepository" as faqrepo
participant "BookingService" as booksvc
database "Database" as db

student -> routes : POST /questions (office, question)
routes -> faqsvc : match(office, question)
faqsvc -> faqrepo : findByOffice(office)
faqrepo -> db : SELECT faqs
db --> faqrepo : faqs
faqrepo --> faqsvc : faqs
faqsvc --> routes : Match(answer, score) or none
routes --> student : suggested answer (if any)

alt answer resolves the request
  student -> routes : mark as satisfactory
  note right : flow ends, no appointment created
else answer not satisfactory (or no match found)
  student -> routes : GET /offices/{office}/availability
  routes --> student : available time slots
  student -> routes : POST /appointments (slot, question)
  routes -> booksvc : book(student, office, slot, question)
  booksvc -> db : insert appointment
  db --> booksvc : ok
  booksvc --> routes : appointment
  routes --> student : booking confirmed
end
@enduml
