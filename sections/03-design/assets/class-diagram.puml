@startuml class-diagram
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "Identity Context" {
  class User <<aggregate root>> {
    id : int
    email : string
    firstName : string
    lastName : string
    role : Role
    isActive : bool
    credentials : Credentials
  }
  enum Role <<value object>> {
    STUDENT
    EMPLOYEE
    ADMIN
  }
  class Credentials <<value object>> {
    passwordHash : string
    lastLogin : datetime [0..1]
  }
  class StudentProfile <<entity>> {
    matricola : string
    degreeProgramme : string
  }
}

package "Booking Context" {
  class Office <<aggregate root, shared kernel>> {
    id : int
    code : string
    name : string [it, en]
    contactEmail : string
    slotDurationMinutes : int
    isActive : bool
  }
  enum Language <<value object, shared kernel>> {
    IT
    EN
  }
  class EmployeeProfile <<aggregate root>> {
    id : int
  }
  class Shift <<entity>> {
    id : int
    weekday : Weekday
    startTime : time
    endTime : time
  }
  enum Weekday <<value object>> {
    MONDAY
    ...
    SUNDAY
  }
  class Appointment <<aggregate root>> {
    id : int
    status : AppointmentStatus
    slot : TimeSlot
    questionText : string
    questionLanguage : Language
    createdAt : datetime
  }
  class TimeSlot <<value object>> {
    start : datetime
  }
  enum AppointmentStatus <<value object>> {
    BOOKED
    CANCELLED
    COMPLETED
  }
}

package "Support Context" {
  class Faq <<aggregate root>> {
    id : int
    question : string [it, en]
    answer : string [it, en]
    isActive : bool
  }
  class Inquiry <<aggregate root>> {
    id : UUID
    text : string
    language : Language
    score : float [0..1]
    matchedBy : MatchMethod [0..1]
    resolved : bool
    createdAt : datetime
  }
  class Match <<value object>> {
    faq : Faq
    score : float
    matchedBy : MatchMethod
  }
  enum MatchMethod <<value object>> {
    FULL_TEXT
    SEMANTIC
  }
}

User "1" *-- "0..1" StudentProfile
EmployeeProfile "0..1" --> "1" User : is
EmployeeProfile "*" --> "1" Office : worksFor
EmployeeProfile "1" *-- "*" Shift
Appointment "1" *-- "1" TimeSlot
Appointment "*" --> "1" Office : at
Appointment "*" --> "1" User : bookedBy
Appointment "*" --> "1" EmployeeProfile : handledBy
Appointment "*" --> "0..1" Faq : suggestedFaq
Faq "*" --> "1" Office : filedUnder
Inquiry "*" --> "0..1" Office : filedUnder
Inquiry "*" --> "0..1" Faq : matchedFaq
Match "*" --> "1" Faq
@enduml
