@startuml class-diagram
skinparam classAttributeIconSize 0
hide empty members

package "Identity Context" {
  class User <<aggregate root>> {
    id : int
    email : string
    firstName : string
    lastName : string
    role : Role
    isActive : bool
    credentials : Credentials
    authenticate(password) : bool
    verifyEmail()
  }

  enum Role <<value object>> {
    STUDENT
    EMPLOYEE
    ADMIN
  }

  class Credentials <<value object>> {
    passwordHash : string
    lastLogin : datetime
  }

  class StudentProfile <<value object>> {
    matricola : string
    degreeProgramme : string
  }
}

package "Shared Kernel" {
  class Office <<entity>> {
    id : int
    code : string
    name : string
    contactEmail : string
    slotDurationMinutes : int
    isActive : bool
  }
}

package "Booking Context" {
  class Appointment <<aggregate root>> {
    id : int
    status : AppointmentStatus
    slot : TimeSlot
    questionText : string
    questionLanguage : string
    book()
    cancel(by)
    complete()
  }

  class TimeSlot <<value object>> {
    start : datetime
    durationMinutes : int
  }

  enum AppointmentStatus <<value object>> {
    BOOKED
    CANCELLED
    COMPLETED
  }

  class Employee <<entity>> {
    id : int
  }

  class Shift <<aggregate root>> {
    id : int
    weekday : Weekday
    startTime : time
    endTime : time
    declare()
    withdraw()
  }
}

package "Support Context" {
  class Faq <<aggregate root>> {
    id : int
    question : string [it, en]
    answer : string [it, en]
    isActive : bool
  }

  class Inquiry <<aggregate root>> {
    id : UUID
    text : string
    language : string
    score : float
    matchedBy : MatchMethod
    resolved : bool
    resolve()
  }

  class Match <<value object>> {
    faq : Faq
    score : float
    matchedBy : MatchMethod
  }

  enum MatchMethod <<value object>> {
    FULL_TEXT
    SEMANTIC
  }
}

User "1" *-- "0..1" StudentProfile
Appointment "1" *-- "1" TimeSlot
Appointment "*" --> "1" Office : at
Appointment "*" --> "1" User : bookedBy
Appointment "*" --> "1" Employee : handledBy
Appointment "*" --> "0..1" Faq : suggestedFaq
Employee "0..1" --> "1" User : is
Employee "*" --> "1" Office : worksFor
Shift "*" --> "1" Employee : declaredBy
Faq "*" --> "1" Office : filedUnder
Inquiry "*" --> "1" Office : askedAbout
Inquiry "*" --> "0..1" Faq : matchedFaq
Match "*" --> "1" Faq
@enduml
